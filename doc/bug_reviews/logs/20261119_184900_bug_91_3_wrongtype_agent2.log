package io.velo.command

import io.activej.bytebuf.ByteBuf
import io.activej.promise.Promise
import io.velo.BaseCommand
import io.velo.CompressedValue
import io.velo.MultiWorkerServer
import io.velo.TypeMismatchException
import io.velo.decode.Request
import io.velo.mock.InMemoryGetSet
import io.velo.persist.Consts
import io.velo.persist.LocalPersist
import io.velo.persist.LocalPersistTest
import io.velo.reply.AsyncReply
import io.velo.reply.ErrorReply
import spock.lang.Specification

import java.nio.charset.StandardCharsets

class Bug913ReviewTempTest extends Specification {
    def 'same worker secondary list wrong type uses ERR on wire'() {
        given:
        LocalPersistTest.prepareLocalPersist()
        def local = LocalPersist.instance
        local.fixSlotThreadId((short) 0, Thread.currentThread().threadId())
        def store = new InMemoryGetSet()
        def group = new BGroup(null, null, null)
        group.from(BaseCommand.mockAGroup())
        group.byPassGetSet = store
        group.crossRequestWorker = false
        def cv = new CompressedValue()
        cv.dictSeqOrSpType = 0
        cv.compressedData = 'value'.bytes
        store.put((short) 0, 'wrong', 0, cv)
        def transfer = MultiWorkerServer.getDeclaredMethod('transferAsyncReply', Request, AsyncReply, Boolean.TYPE)
        transfer.accessible = true
        def server = new MultiWorkerServer()

        expect:
        ['blpop', 'brpop'].every { String cmd ->
            def reply = group.execute(cmd + ' empty wrong 1')
            assert reply instanceof AsyncReply
            def async = (AsyncReply) reply
            assert async.settablePromise.getException() instanceof TypeMismatchException
            def request = new Request([cmd.bytes, 'empty'.bytes, 'wrong'.bytes, '1'.bytes] as byte[][], false, false)
            def encoded = (Promise<ByteBuf>) transfer.invoke(server, request, async, false)
            def wire = new String(encoded.getResult().asArray(), StandardCharsets.UTF_8)
            println cmd + ' crossRequestWorker=false wire=' + wire.trim()
            assert wire.startsWith('-ERR Expect sp type array=')
            assert !wire.startsWith('-WRONGTYPE')
            true
        }

        cleanup:
        local?.cleanUp()
        Consts.persistDir.deleteDir()
    }
}

