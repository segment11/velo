#!/usr/bin/env python3
# Temp Redis 7.2 differential for bug 85 verification (85.4/85.6/85.7/85.10/85.11). Delete after use.
import socket, sys

HOST, PORT = '127.0.0.1', 47999

def encode_cmd(*args):
    out = b'*%d\r\n' % len(args)
    for a in args:
        if isinstance(a, str):
            a = a.encode()
        out += b'$%d\r\n%s\r\n' % (len(a), a)
    return out

def read_reply(f):
    line = f.readline()
    if not line:
        raise EOFError
    t, rest = line[:1], line[1:-2]
    if t == b'+':
        return rest.decode()
    if t == b'-':
        return 'ERR-TYPE-REPLY: ' + rest.decode()
    if t == b':':
        return int(rest)
    if t == b'$':
        n = int(rest)
        if n == -1:
            return None
        data = f.read(n + 2)[:-2]
        return data
    if t == b'*':
        n = int(rest)
        return [read_reply(f) for _ in range(n)]
    raise ValueError('bad type %r' % t)

s = socket.create_connection((HOST, PORT), timeout=3)
f = s.makefile('rb')

def cmd(*args):
    s.sendall(encode_cmd(*args))
    return read_reply(f)

print('== 85.10 READONLY on non-cluster ==')
print('READONLY      ->', cmd('READONLY'))
print('READWRITE     ->', cmd('READWRITE'))

print('== 85.11 error texts ==')
print('RENAME missing other ->', cmd('RENAME', 'missing85', 'other85'))

cmd('DEL', 'src85', 'existing85', 'dst85', 'k85a', 'k85b', 'k85c', 'k85d', 'lst85src', 'lst85dst')
cmd('SET', 'src85', 'v')
cmd('SET', 'existing85', 'v')
dump = cmd('DUMP', 'src85')

print('RESTORE existing85 0 <dump> (no REPLACE) ->', cmd('RESTORE', 'existing85', '0', dump))

print('== 85.6 non-numeric ttl ==')
print('RESTORE k85a abc <dump> ->', cmd('RESTORE', 'k85a', 'abc', dump))

print('== 85.7 unknown option / negative ttl / idletime+freq ==')
print('RESTORE k85b 0 <dump> badoption ->', cmd('RESTORE', 'k85b', '0', dump, 'badoption'))
print('RESTORE k85c -1 <dump> ->', cmd('RESTORE', 'k85c', '-1', dump))
print('RESTORE k85d 0 <dump> idletime 5 freq 3 ->', cmd('RESTORE', 'k85d', '0', dump, 'idletime', '5', 'freq', '3'))

print('== 85.6/85.7 ordering: busykey vs bad ttl ==')
print('RESTORE existing85 abc <dump> ->', cmd('RESTORE', 'existing85', 'abc', dump))

print('== 85.4 redis side: ttl applied to a restored list ==')
cmd('RPUSH', 'lst85src', 'a', 'b', 'c')
ldump = cmd('DUMP', 'lst85src')
print('RESTORE lst85dst 60000 <list dump> ->', cmd('RESTORE', 'lst85dst', '60000', ldump))
print('TYPE lst85dst  ->', cmd('TYPE', 'lst85dst'))
print('PTTL lst85dst  ->', cmd('PTTL', 'lst85dst'))
print('EXISTS k85b (badoption key) ->', cmd('EXISTS', 'k85b'))
s.close()
