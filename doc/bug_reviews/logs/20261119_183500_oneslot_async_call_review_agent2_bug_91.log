package io.velo.persist

import io.activej.eventloop.Eventloop
import io.velo.BaseCommand
import io.velo.ValkeyRawConfSupport
import io.velo.acl.AclUsers
import io.velo.command.AGroup
import io.velo.repl.Binlog
import io.velo.repl.BinlogContent
import io.velo.reply.OKReply
import spock.lang.Specification

import java.util.concurrent.atomic.AtomicInteger

class Bug91ReviewTempTest extends Specification {
    def 'acl save returns OK before queued binlog append fails'() {
        given:
        LocalPersistTest.prepareLocalPersist()
        AclUsers.instance.initForTest()
        def local = LocalPersist.instance
        def slot = local.oneSlot((short) 0)
        slot.dynConfig.binlogOn = true
        def originalBinlog = slot.binlog
        def attempts = new AtomicInteger()
        def failingDir = java.nio.file.Files.createTempDirectory('velo-bug91-binlog-').toFile()
        def failingBinlog = new FailingBinlog(failingDir, slot.dynConfig, attempts)
        slot.binlog = failingBinlog
        def caller = Eventloop.builder().withCurrentThread().build()
        def target = Eventloop.builder().build()
        def worker = new Thread({ target.run() } as Runnable)
        slot.slotWorkerEventloop = target
        slot.threadIdProtectedForSafe = worker.threadId()
        def aclFile = File.createTempFile('velo-bug91-', '.acl')
        def previousFilename = ValkeyRawConfSupport.aclFilename
        ValkeyRawConfSupport.aclFilename = aclFile.absolutePath
        def group = new AGroup(null, null, null)
        group.from(BaseCommand.mockAGroup())

        when:
        def saveSlots = group.parseSlots('acl', ['acl'.bytes, 'save'.bytes] as byte[][], 2)
        def loadSlots = group.parseSlots('acl', ['acl'.bytes, 'load'.bytes] as byte[][], 2)
        def reply = group.execute('acl save')

        then:
        saveSlots.isEmpty()
        loadSlots.isEmpty()
        reply == OKReply.INSTANCE
        attempts.get() == 0

        when:
        println 'BUG91.1 before target runs: saveSlots=[], loadSlots=[], reply=OK, appendAttempts=0'
        worker.start()
        caller.run()
        worker.join(5000)

        then:
        attempts.get() == 1
        !worker.alive
        reply == OKReply.INSTANCE
        println 'BUG91.1 after target runs: injected IOException, appendAttempts=1, original reply remains OK'

        cleanup:
        target?.breakEventloop()
        worker?.join(5000)
        if (slot != null) {
            slot.binlog = originalBinlog
            slot.threadIdProtectedForSafe = Thread.currentThread().threadId()
        }
        ValkeyRawConfSupport.aclFilename = previousFilename
        aclFile?.delete()
        failingBinlog?.cleanUp()
        failingDir?.deleteDir()
        local?.cleanUp()
        Consts.persistDir.deleteDir()
    }
}

class FailingBinlog extends Binlog {
    final AtomicInteger attempts
    FailingBinlog(File dir, DynConfig config, AtomicInteger attempts) {
        super((short) 0, dir, config)
        this.attempts = attempts
    }
    @Override
    void append(BinlogContent content) throws IOException {
        attempts.incrementAndGet()
        throw new IOException('bug91 injected append failure')
    }
}


