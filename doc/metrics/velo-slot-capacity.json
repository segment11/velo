          "qryType": 1,
          "query": "label_values(global_up_time, instance)",
          "refId": "StandardVariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "slot",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "velo-prom"
        },
        "definition": "label_values(slot_kv_lru_hit_ratio, slot)",
